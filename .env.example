# Copy to .env (git-ignored) and adjust. Used by the dev:* scripts in apps/api.
# RDS emulated by floci, reached through the local TCP forward (see docs/LOCAL-DEV.md).
ADMIN_DATABASE_URL=postgres://root:CHANGE_ME@localhost:5433/fintech-db
APP_DB_PASSWORD=app_user_dev
RELAY_DB_PASSWORD=outbox_relay_dev
DATABASE_URL=postgres://app_user:app_user_dev@localhost:5433/fintech-db
RELAY_DATABASE_URL=postgres://outbox_relay:outbox_relay_dev@localhost:5433/fintech-db
JWT_SECRET=dev-secret-dev-secret-dev-secret-0000
PORT=3000

# floci (AWS emulator)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
QUEUE_NAME=transactions-queue
DLQ_NAME=TransactionsDLQ
QUEUE_URL=http://localhost:4566/000000000000/transactions-queue

# Local worker: clear | reject | down
BANK_MODE=clear

# Web support (local development only): simulated login route + CORS for apps/web
DEV_LOGIN_ENABLED=true
CORS_ORIGIN=http://localhost:3001
