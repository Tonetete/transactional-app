{
  "name": "@acex/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx --env-file=../../.env src/main.ts",
    "dev:setup": "tsx --env-file=../../.env src/dev/setup.ts",
    "dev:relay": "tsx --env-file=../../.env src/relay-main.ts",
    "dev:worker": "tsx --env-file=../../.env src/dev/worker.ts",
    "dev:token": "tsx --env-file=../../.env src/dev/token.ts",
    "bundle": "esbuild src/main.ts src/relay-main.ts src/provision-main.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --out-extension:.js=.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" && mkdir -p dist/migrations && cp src/db/migrations/*.sql dist/migrations/"
  },
  "dependencies": {
    "@acex/shared": "workspace:*",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "kysely": "^0.29.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "testcontainers": "^12.2.1"
  }
}
